# Pinned tool versions for the platform foundation (spec 01). Bump deliberately, then re-run scripts/install-all.sh.
# Versions looked up 2026-11-15. kubectl must stay within one minor version of k3s.
K3S_VERSION=v1.37.2+k3s1
KUBECTL_VERSION=v1.37.2
HELM_VERSION=v4.3.2
FLUX_VERSION=2.10.0
# apt package version is "<NVIDIA_CTK_VERSION>-1"
NVIDIA_CTK_VERSION=1.20.1
# Chart version; keep in sync with deploy/platform/nvidia-device-plugin/helmrelease.yaml
NVIDIA_DEVICE_PLUGIN_CHART_VERSION=0.20.1
