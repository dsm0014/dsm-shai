# Repositories the maintainer looks after (spec 16). One section per repo; a repo must ALSO be in MAINT_ALLOWED_REPOS and
# SWARM_ALLOWED_REPOS or it is refused. Copy to repos.yaml (or use MAINT_REPOS=owner/name,owner/name for the defaults).
dsm0014/dsm-shai:
  mode: observe                 # observe | merge | merge-and-run
  tasklist_path: .specter/tasklist.md
  branch_prefix: swarm/
  reviewer: haiku               # haiku | chat (chat may approve only small markdown-only changes)
  max_merges_per_run: 1
  max_merges_per_day: 8
  max_attempts: 2
  merge_deploy: false
  auto_queue: false
