# Copy to %UserProfile%\.wslconfig on Windows (scripts/00-wsl-host.sh does this if the file is absent),
# then run `wsl --shutdown` from Windows and restart WSL.
[wsl2]
# 24GB of the 32GB host; leaves ~8GB for Windows. WSL2 defaults to ~15GB.
memory=24GB
# Leaves 4 of 24 threads for Windows.
processors=20
swap=8GB
